{
  "name": "docs-addon",
  "private": true,
  "version": "0.0.1",
  "scripts": {
    "dev": "vite",
    "build": "vite build --mode development",
    "build:dev": "rm -rf dist/ && mkdir dist/ && cp appsscript.json public/; pnpm --filter sidebar --filter template-page --filter dialog run --parallel build --mode development && mv dialog/dist/index.html dist/dialog.html && mv sidebar/dist/index.html dist/sidebar.html && mv template-page/dist/index.html dist/template-page.html && for f in $(ls -a public/ | tail -n +3); do cp public/$f dist/; done; pnpm -w run build:server && mv server/Code.js dist/Code.gs",
    "build:server": "node -r esbuild-runner/register ./server/build.ts > ./server/Code.js",
    "build:watch": "# TODO: Fix this\nnodemon --exec 'pnpm run build'",
    "preview": "vite preview",
    "clasp:create": "pnpm build && cd dist && clasp create --title Flowcast --type docs && cp appsscript.json .. && cp .clasp.json ../public",
    "clasp:status": "cd dist && clasp status",
    "typecheck": "tsc --project tsconfig.server.json",
    "clasp:push": "pnpm -w --filter sidebar --filter template-page --filter dialog run --parallel typecheck && pnpm build && pnpm run clasp:prebuilt",
    "clasp:dev": "pnpm build:dev && pnpm run clasp:prebuilt",
    "clasp:prebuilt": "cd dist && clasp push",
    "clasp:watch": "nodemon --exec 'pnpm run clasp:dev'",
    "lint:fix": "prettier --write .",
    "lint": "prettier --check ."
  },
  "dependencies": {
    "@codemirror/commands": "^6.0.1",
    "@codemirror/lang-json": "^6.0.0",
    "@codemirror/lint": "^6.0.0",
    "@codemirror/state": "^6.1.0",
    "@codemirror/view": "^6.0.2",
    "@fortawesome/fontawesome-svg-core": "^6.1.1",
    "@fortawesome/free-solid-svg-icons": "^6.1.1",
    "@fortawesome/vue-fontawesome": "^3.0.1",
    "@headlessui/vue": "^1.6.5",
    "autoprefixer": "^10.4.7",
    "codemirror": "^6.0.1",
    "deepmerge": "^4.2.2",
    "es-module-lexer": "^1.0.3",
    "floating-vue": "2.0.0-beta.17",
    "js-base64": "^3.7.2",
    "mermaid": "^9.1.3",
    "pako": "^2.0.4",
    "svg-pan-zoom": "^3.6.1",
    "tailwindcss": "^3.1.4",
    "uuid": "^8.3.2",
    "vue": "^3.2.37"
  },
  "devDependencies": {
    "@google/clasp": "^2.4.1",
    "@rollup/plugin-alias": "^5.1.0",
    "@types/google-apps-script": "^1.0.49",
    "@types/node": "^18.0.0",
    "@types/pako": "^2.0.0",
    "@types/codemirror": "^5.60.5",
    "@types/google.script.client-side": "^0.1.1",
    "@types/mermaid": "^8.2.9",
    "@types/uuid": "^8.3.4",
    "@types/webspeechapi": "^0.0.29",
    "postcss": "^8.4.14",
    "@vitejs/plugin-vue": "^5.0.4",
    "esbuild": "^0.14.48",
    "esbuild-runner": "^2.2.1",
    "nodemon": "^2.0.19",
    "ts-node": "^10.8.2",
    "typescript": "^4.7.4",
    "vite": "^5.1.5",
    "vue-tsc": "^0.35.2"
  }
}
