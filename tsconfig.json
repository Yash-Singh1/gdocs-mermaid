{
  "compilerOptions": {
    "target": "esnext",
    "useDefineForClassFields": true,
    "module": "esnext",
    "moduleResolution": "node",
    "strict": true,
    "jsx": "preserve",
    "sourceMap": true,
    "resolveJsonModule": true,
    // "isolatedModules": true,
    "esModuleInterop": true,
    "lib": ["esnext", "dom"],
    "skipLibCheck": true,
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "routes/**/*.ts",
    "routes/**/*.d.ts",
    "routes/**/*.tsx",
    "routes/**/*.vue",
    "server/**/*.ts",
  ],
  "references": [{ "path": "./tsconfig.node.json" }]
}
